// use prisma-next

enum UserRole {
  @@type("pg/text@1")

  ADMIN = "ADMIN"
  USER  = "USER"
}

enum RoomRole {
  @@type("pg/text@1")

  OWNER  = "OWNER"
  ADMIN  = "ADMIN"
  MEMBER = "MEMBER"
}

enum DeviceType {
  @@type("pg/text@1")

  ESP32   = "ESP32"
  ESP8266 = "ESP8266"
}

model User {
  id String @id @default(uuid())

  username     String @unique
  email        String @unique
  passwordHash String @map("password_hash")

  firstName String @map("first_name")
  lastName  String @map("last_name")

  role UserRole @default(USER)

  isActive     Boolean @default(true) @map("is_active")
  tokenVersion Int     @default(0) @map("token_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  passwordResetTokens PasswordResetToken[]//para recuperación de contraseña

  ownedRooms  Room[]       @relation("RoomOwner")
  roomMembers RoomMember[]

  @@map("users")
  sentRoomInvitations RoomInvitation[] @relation("InvitationSender")
  createdProjects Project[] @relation("ProjectCreator")
  createdDevices Device[] @relation("DeviceCreator")
  
}


//modelo para recuperacion de contraseñas, está relacionado con el modelo user
model PasswordResetToken {
  id String @id @default(uuid())

  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

//modelo de la sala
model Room {
  id String @id @default(uuid())

  name        String
  nameKey     String @map("name_key")
  description String?

  ownerId String @map("owner_id")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  owner   User         @relation("RoomOwner", fields: [ownerId], references: [id])
  members RoomMember[]
  invitations RoomInvitation[]//relacion de las invitaciones
  projects Project[]

  @@unique([ownerId, nameKey])
  @@index([ownerId])
  @@map("rooms")

  
}

model RoomMember {
  id String @id @default(uuid())

  roomId String @map("room_id")
  userId String @map("user_id")

  role RoomRole @default(MEMBER)

  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("room_members")
}

model RoomInvitation {
  id String @id @default(uuid())

  roomId      String @map("room_id")
  invitedById String @map("invited_by_id")

  invitedEmail String @map("invited_email")

  role RoomRole @default(MEMBER)

  tokenHash String @unique @map("token_hash")

  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  rejectedAt DateTime? @map("rejected_at")

  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(
    fields: [roomId],
    references: [id],
    onDelete: Cascade
  )

  invitedBy User @relation(
    "InvitationSender",
    fields: [invitedById],
    references: [id],
    onDelete: Cascade
  )

  @@index([roomId])
  @@index([invitedById])
  @@index([invitedEmail])

  @@map("room_invitations")
}

model Project {
  id String @id @default(uuid())

  roomId      String @map("room_id")
  createdById String @map("created_by_id")

  name        String
  nameKey     String @map("name_key")
  description String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  room Room @relation(
    fields: [roomId],
    references: [id],
    onDelete: Cascade
  )

  createdBy User @relation(
    "ProjectCreator",
    fields: [createdById],
    references: [id]
  )

  devices Device[]

  @@unique([roomId, nameKey])
  @@index([roomId])
  @@index([createdById])

  @@map("projects")
}

//modelo para registrar dispositivo esp32
model Device {
  id String @id @default(uuid())

  projectId   String @map("project_id")
  createdById String @map("created_by_id")

  name    String
  nameKey String @map("name_key")

  deviceType DeviceType @map("device_type")

  hardwareId String? @unique @map("hardware_id")

  isPaired Boolean @default(false) @map("is_paired")
  isActive Boolean @default(true) @map("is_active")

  lastSeenAt DateTime? @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  project Project @relation(
    fields: [projectId],
    references: [id],
    onDelete: Cascade
  )

  createdBy User @relation(
    "DeviceCreator",
    fields: [createdById],
    references: [id]
  )

  pairingTokens DevicePairingToken[]
  credentials DeviceCredential[]

  @@unique([projectId, nameKey])
  @@index([projectId])
  @@index([createdById])

  @@map("devices")
}

model DevicePairingToken {
  id String @id @default(uuid())

  deviceId String @map("device_id")

  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  device Device @relation(
    fields: [deviceId],
    references: [id],
    onDelete: Cascade
  )

  @@index([deviceId])

  @@map("device_pairing_tokens")
}

model DeviceCredential {
  id String @id @default(uuid())

  deviceId String @map("device_id")

  credentialHash String @unique @map("credential_hash")

  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  device Device @relation(
    fields: [deviceId],
    references: [id],
    onDelete: Cascade
  )

  @@index([deviceId])

  @@map("device_credentials")
}